rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function myUserDoc() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    // Guarded: a signed-in user whose /users doc does not exist yet (the
    // moment between creating an auth account and writing the profile) must
    // not blow up rule evaluation. An unguarded get() on a missing document
    // errors, and an error denies the whole request — which broke sign-up.
    function myRole() {
      return isSignedIn() && exists(myUserDoc())
        ? get(myUserDoc()).data.get('role', '')
        : '';
    }

    // Elevated = can see and manage the whole workspace.
    function isElevated() {
      return myRole() in ['admin', 'founder'];
    }

    // Delegated permissions are the founder's alone to hand out — an admin
    // who could grant them could escalate themselves or a peer past the role
    // system, which is the one thing this design must not allow.
    function isFounder() {
      return myRole() == 'founder';
    }

    function isMe(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // ── Delegated permissions ───────────────────────────────────────────────
    // users/{uid}.permissions is a map of capability -> bool, e.g.
    //   { assignAnyTask: true, manageAnnouncements: false, … }
    // It lets a founder grant ONE ability to ONE person without promoting them
    // to admin. Roles are unchanged.
    //
    // THE MISSING-FIELD TRAP — the bug that broke sign-up for everyone today.
    // An unguarded get() on a document that does not exist, or a bare field
    // read of a field that is absent, ERRORS. A rule error is not `false`: it
    // denies the entire request. Almost every profile in this workspace
    // predates this feature and has no `permissions` field at all, so every
    // step below is guarded:
    //
    //   1. exists(myUserDoc())            — no get() on a missing document
    //   2. .data.get('permissions', {})   — absent field yields an empty map
    //   3. `is map`                       — a permissions field of the wrong
    //                                       type yields false, never an error,
    //                                       because .get(p, …) on a non-map
    //                                       would itself error
    //   4. .get(p, false)                 — absent capability yields false
    //
    // Result: for a user with no profile, no permissions field, a malformed
    // permissions field, or a permissions map missing this key, hasPerm()
    // returns plain `false` and evaluation continues to the next disjunct.
    function myPerms() {
      return isSignedIn() && exists(myUserDoc())
        ? get(myUserDoc()).data.get('permissions', {})
        : {};
    }

    function hasPerm(p) {
      return myPerms() is map && myPerms().get(p, false) == true;
    }

    // True when a write leaves `permissions` exactly as it was. Used to let
    // admins keep every management power they had while making the permission
    // map itself off-limits to everyone but a founder. .get() on both sides so
    // a document without the field compares an empty map to an empty map
    // rather than erroring.
    function permsUnchanged() {
      return request.resource.data.get('permissions', {})
          == resource.data.get('permissions', {});
    }

    function roleUnchanged() {
      return request.resource.data.get('role', '') == resource.data.get('role', '');
    }

    // ── Users ───────────────────────────────────────────────────────────────
    // Anyone signed in can read the directory. You may edit your own profile
    // but NOT your own role: a new account is pinned to 'employee', and any
    // later write must leave `role` exactly as it was. Promotion is therefore
    // only possible through an existing admin/founder, which the elevated
    // allow-blocks below grant. (Rules are OR'd, so elevated users bypass the
    // self-service restrictions.)
    //
    // Nobody may edit their OWN permissions — not even a founder, who does not
    // need to: they already outrank every capability.
    match /users/{userId} {
      allow read: if isSignedIn();

      allow create: if isMe(userId)
        && (!('role' in request.resource.data) || request.resource.data.role == 'employee')
        && !('permissions' in request.resource.data);

      // .get() so a profile missing the field cannot error the rule out.
      allow update: if isMe(userId)
        && roleUnchanged()
        && permsUnchanged();

      // Elevated users manage the workspace: create, promote, edit, remove.
      // Unchanged from before EXCEPT that `permissions` is carved out — an
      // admin must not be able to grant capabilities. Every other field an
      // admin could write before, they can still write.
      allow create: if isElevated() && !('permissions' in request.resource.data);
      allow update: if isElevated() && permsUnchanged();
      allow delete: if isElevated();

      // Only a founder may set another person's permissions.
      allow create, update: if isFounder() && !isMe(userId);

      // Delegated: edit teammates' profile fields (department, shift windows).
      // Explicitly cannot touch role or permissions, so this grant can never
      // be used to widen itself.
      allow update: if hasPerm('manageMembers')
        && roleUnchanged()
        && permsUnchanged();
    }

    // ── Time entries (attendance) ───────────────────────────────────────────
    // Previously absent from this file entirely, which meant either the
    // deployed rules did not match this source, or attendance was fully open.
    // A day may hold several sessions per user; each is its own document.
    match /timeEntries/{entryId} {
      allow read: if isElevated()
        || hasPerm('viewAllAttendance')
        || (isSignedIn() && resource.data.get('userId', '') == request.auth.uid);

      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'active';

      // Only userId was pinned, so a user could rewrite `date` and `clockIn` on
      // their own entry — "mark me present all of last month" was a loop.
      // The day and start time are now immutable; closing a session (status,
      // clockOut, breaks, totalMinutes) still works normally.
      allow update: if isElevated()
        || (isSignedIn()
            && resource.data.get('userId', '') == request.auth.uid
            && request.resource.data.userId == resource.data.userId
            && request.resource.data.date == resource.data.date
            && request.resource.data.clockIn == resource.data.clockIn);

      allow delete: if isElevated();
    }

    // ── Sessions ────────────────────────────────────────────────────────────
    match /sessions/{sessionId} {
      allow read: if isElevated()
        || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow delete: if isElevated();
    }

    // ── Chats ───────────────────────────────────────────────────────────────
    match /chats/{chatId} {
      allow read: if isSignedIn() && request.auth.uid in resource.data.members;
      allow create: if isSignedIn() && request.auth.uid in request.resource.data.members;

      // `update` previously let any member rewrite `members` — adding an
      // outsider to a private conversation, or removing everyone else. The app
      // only updates lastMsg/lastAt, so freeze the membership list.
      allow update: if isSignedIn()
        && request.auth.uid in resource.data.members
        && request.resource.data.members == resource.data.members;

      // `delete` was granted to any member, so one participant could destroy
      // the whole conversation for everyone in it.
      allow delete: if isElevated();

      match /messages/{messageId} {
        // `write` covered create, update AND delete for any member, and nothing
        // checked senderId — so a member could post a message AS a colleague,
        // and edit or delete anyone else's. Authorship is now pinned on create
        // and required on change.
        allow read: if isSignedIn()
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.members;

        allow create: if isSignedIn()
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.members
          && request.resource.data.senderId == request.auth.uid;

        allow update, delete: if isSignedIn()
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.members
          && resource.data.get('senderId', '') == request.auth.uid;
      }
    }

    // ── Tasks ───────────────────────────────────────────────────────────────
    // `assignAnyTask` is the delegated capability the founder asked for by
    // name: "I can give permission to person X to assign tasks to anyone."
    // It joins isElevated() as a disjunct on read (so the whole-collection
    // list query the Assign Tasks board runs is allowed — rules are not
    // filters, so every document a list can return must satisfy the read
    // rule), on create with a foreign `assignedTo`, and on update so a task
    // can be moved between people.
    //
    // Create is also now explicit that WITHOUT one of those two, you may only
    // create a task for yourself. Previously the only condition was
    // `createdBy == uid`, leaving `assignedTo` entirely unconstrained — any
    // employee could push work onto anyone. That is the restriction this
    // permission exists to lift.
    match /tasks/{taskId} {
      allow read: if isElevated()
        || hasPerm('assignAnyTask')
        || (isSignedIn() && (
              resource.data.get('assignedTo', '') == request.auth.uid ||
              resource.data.get('createdBy', '') == request.auth.uid
            ));

      allow create: if isSignedIn()
        && request.resource.data.createdBy == request.auth.uid
        && (
          request.resource.data.get('assignedTo', request.auth.uid) == request.auth.uid
          || isElevated()
          || hasPerm('assignAnyTask')
        );

      allow update, delete: if isElevated()
        || hasPerm('assignAnyTask')
        || (isSignedIn() && (
              resource.data.get('assignedTo', '') == request.auth.uid ||
              resource.data.get('createdBy', '') == request.auth.uid
            ));
    }

    // ── Resources ───────────────────────────────────────────────────────────
    // Previously `write: if isElevated()`, which meant only admins could add a
    // resource — the shared team hub could not work. Any signed-in member may
    // now contribute; `createdBy` is pinned to the caller's uid so authorship
    // cannot be forged, and only the author (or an admin, or a delegate with
    // `manageResources`) may change or remove it afterwards.
    //
    // VISIBILITY + THE LIST QUERY
    // Rules are not filters: a list query is rejected outright unless every
    // document it can return satisfies the read rule. The read rule below is a
    // three-way OR across three different fields, which a single Firestore
    // query cannot express, so the client (Resources.jsx) runs one equality
    // query per disjunct and merges the results:
    //
    //   where('visibility', '==', 'everyone')  → satisfies clause 1
    //   where('createdBy',  '==', uid)         → satisfies clause 2
    //   where('sharedWith', '==', uid)         → satisfies clause 3
    //
    // Every document each query can return satisfies its clause by
    // construction, so none of the three can be denied. Admins/founders skip
    // all of it via isElevated() and list the collection unfiltered, as does a
    // delegate holding `manageResources`.
    //
    // `.get(field, default)` is used throughout: reading a missing field errors
    // rule evaluation, and an error denies the request. The 'everyone' default
    // on `visibility` keeps pre-existing documents (written before this feature
    // had a visibility field) readable exactly as they were under the old rule.
    match /resources/{resourceId} {
      allow read: if isElevated() || hasPerm('manageResources') || (isSignedIn() && (
        resource.data.get('visibility', 'everyone') == 'everyone' ||
        resource.data.get('createdBy', '') == request.auth.uid ||
        resource.data.get('sharedWith', '') == request.auth.uid
      ));

      allow create: if isSignedIn()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.visibility in ['everyone', 'person']
        && request.resource.data.description is string
        && request.resource.data.description.size() > 0
        && request.resource.data.description.size() <= 2000
        && request.resource.data.kind in ['file', 'link']
        // 'person' must name someone; 'everyone' must not.
        && (request.resource.data.visibility == 'everyone'
              ? request.resource.data.sharedWith == null
              : request.resource.data.sharedWith is string);

      // Authorship is immutable — an update may not hand the document to
      // someone else, or steal one.
      allow update: if isElevated() || hasPerm('manageResources') || (isSignedIn()
        && resource.data.get('createdBy', '') == request.auth.uid
        && request.resource.data.createdBy == resource.data.createdBy);

      allow delete: if isElevated()
        || hasPerm('manageResources')
        || (isSignedIn() && resource.data.get('createdBy', '') == request.auth.uid);
    }

    // ── MCP connection sessions ─────────────────────────────────────────────
    // One document per Claude connection, for the hosted MCP server. It holds
    // that person's Firebase refresh token, encrypted with a key only the
    // server has, so the tokens Claude holds can be a pointer rather than a
    // credential. Deleting a document here revokes that connection instantly.
    //
    // WHY `get` IS PUBLIC — this looks wrong, so here is the reasoning.
    // The server has no credential of its own, on purpose: using the Firebase
    // Admin SDK would bypass every rule in this file, so one leaked key would
    // expose the whole workspace. But the server must read the session BEFORE
    // it can act as anyone. That is a bootstrap problem, and this is the
    // resolution:
    //
    //   • the document id is 256 bits of randomness — the id IS the secret,
    //     handed only to the client that authorized, and never in a URL
    //   • `list` is denied, so the collection cannot be enumerated; without
    //     the id there is no way to reach a document
    //   • the only sensitive field is `rtWrapped`, which is AES-256-GCM
    //     ciphertext bound to this document id. Reading it yields nothing.
    //   • every WRITE is authenticated as the owning user, so nobody can mint
    //     a session for somebody else
    //
    // Accepted exposure: anyone who obtains a session id can see that user's
    // uid, which client connected, and the timestamps. They cannot obtain the
    // credential and cannot discover ids they were not given.
    match /mcpSessions/{sid} {
      allow get: if true;
      allow list: if false;

      // Only ever for yourself, and only the known fields — an unexpected field
      // is rejected rather than silently stored.
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly([
             'uid', 'clientId', 'scope', 'gen', 'epoch', 'rtWrapped', 'createdAt', 'lastSeenAt'
           ]);

      // Rotation and activity stamps. Ownership is immutable, and the
      // generation counter may only move forwards — replaying an old refresh
      // token must not be able to wind it back.
      allow update: if isSignedIn()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.get('gen', 0) >= resource.data.get('gen', 0);

      // Disconnect: the owner, or an admin cutting off a departing employee.
      allow delete: if isSignedIn()
        && (resource.data.uid == request.auth.uid || isElevated());

      // Authorization codes must be single-use. Firestore refuses a create on
      // an existing document, so the create IS the compare-and-swap and there
      // is no read-then-write race. Immutable once written, so a redemption
      // cannot be erased and replayed.
      match /redemptions/{jti} {
        allow get, create: if isSignedIn();
        allow update, delete: if false;
      }
    }

    // ── Read-all, admin-write collections ───────────────────────────────────
    match /announcements/{announcementId} {
      allow read: if isSignedIn();
      allow write: if isElevated() || hasPerm('manageAnnouncements');
    }

    match /departments/{deptId} {
      allow read: if isSignedIn();
      allow write: if isElevated();
    }
  }
}
