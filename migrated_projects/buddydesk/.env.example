# ─────────────────────────────────────────────────────────────────────────────
# BuddyDesk — environment configuration
#
# Copy this file to `.env` and fill in the real values:
#     cp .env.example .env
#
# `.env` is gitignored. NEVER commit real keys, and never paste real values back
# into this example file.
#
# Anything prefixed with VITE_ is inlined into the renderer bundle at build time
# and is therefore PUBLIC — treat it as visible to every user of the app. Server
# -only secrets (no VITE_ prefix) are read by the Vercel serverless functions in
# /api and are never shipped to the client.
# ─────────────────────────────────────────────────────────────────────────────

# ─── Firebase (client SDK config) ────────────────────────────────────────────
# Firebase Console → Project settings → General → Your apps → SDK setup & config.
# These are public identifiers by design; access control is enforced by
# firestore.rules and storage.rules, not by hiding these values.

# Web API key for the Firebase project.
VITE_FIREBASE_API_KEY=
# Auth domain, e.g. your-project.firebaseapp.com
VITE_FIREBASE_AUTH_DOMAIN=
# Firebase/GCP project id, e.g. communicationapp-zypit
VITE_FIREBASE_PROJECT_ID=
# Cloud Storage bucket, e.g. your-project.appspot.com
VITE_FIREBASE_STORAGE_BUCKET=
# FCM sender id (numeric).
VITE_FIREBASE_MESSAGING_SENDER_ID=
# Firebase web app id, e.g. 1:1234567890:web:abcdef123456
VITE_FIREBASE_APP_ID=

# ─── Sign-up restriction ─────────────────────────────────────────────────────
# Comma-separated list of email domains allowed to CREATE an account.
# Example: zypit.com,zypit.in        Use "*" to allow any domain (not advised).
# Defaults to "zypit.com" if unset.
# IMPORTANT: keep this in sync with allowedEmailDomains() in firestore.rules —
# the rules file is the authoritative check; this one is only the UI gate.
VITE_ALLOWED_EMAIL_DOMAINS=zypit.com

# ─── BuddyBot AI (server-side only) ──────────────────────────────────────────
# OpenRouter API key used by /api/buddy. Set this in the Vercel project's
# environment variables, NOT in the shipped Electron build.
# Get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# ─── BuddyBot API endpoint (renderer) ────────────────────────────────────────
# Absolute origin that hosts the /api/buddy serverless function.
#
#   Vercel web build   -> leave EMPTY. The function shares the app's origin, so
#                         the relative /api/buddy URL resolves.
#   Electron (dev or   -> REQUIRED. The renderer runs on localhost:5173 or
#   packaged)             file://, neither of which serves /api, so the call
#                         must be absolute.
#
# Example: https://buddydesk.vercel.app   (no trailing slash, no /api suffix)
VITE_API_BASE_URL=
